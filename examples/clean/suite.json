      "declaredMimeType": "image/png",
      "content": {
        "kind": "signature",
        "signature": "png",
        "bytes": 1024
      },
      "expect": {
        "decision": "accept",
        "generatedName": "upload-c889ec5faf131e7a2a89786eceb56027.png"
      }
    },
    {
      "id": "accept-text-padding",
      "description": "Sixty-four repeated bytes for a type whose bytes cannot be checked.",
      "filename": "notes.txt",
      "declaredMimeType": "text/plain",
      "content": {
        "kind": "padding",
        "byte": 65,
        "bytes": 64
      },
      "expect": {
        "decision": "accept",
        "generatedName": "upload-d53eda7a637c99cc7fb566d96e9fa109.txt"
      }
    },
    {
      "id": "reject-empty-file",
      "description": "Zero bytes, which this policy does not accept.",
      "filename": "empty.txt",
      "declaredMimeType": "text/plain",
      "content": {
        "kind": "empty"
      },
      "expect": {
        "decision": "reject",
        "reason": "size-empty"
      }
    },
    {
