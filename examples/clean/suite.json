{
  "schemaVersion": "1",
  "cases": [
    {
      "id": "accept-jpeg-signature",
      "description": "A JPEG header and zero padding: accepted, stored under a digest name.",
      "filename": "scan.jpg",
      "declaredMimeType": "image/jpeg",
      "content": {
        "kind": "signature",
        "signature": "jpeg",
        "bytes": 256
      },
      "expect": {
        "decision": "accept",
        "generatedName": "upload-115865ee563c93918dd97eb3aa8dcc6d.jpg"
      }
    },
    {
      "id": "accept-pdf-signature",
      "description": "A PDF header and zero padding.",
      "filename": "terms.pdf",
      "declaredMimeType": "application/pdf",
      "content": {
        "kind": "signature",
        "signature": "pdf",
        "bytes": 512
      },
      "expect": {
        "decision": "accept",
        "generatedName": "upload-46f591f540baa2c6fe88b17b19891563.pdf"
      }
    },
    {
      "id": "accept-png-signature",
